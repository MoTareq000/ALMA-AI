# ALMA Academy — AI Lesson Generation & Adaptive Runtime Configuration
# ======================================================================

# --- LLM API Keys ---
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Provider & Model Defaults ---
DEFAULT_PROVIDER=google
DEFAULT_GENERATOR_MODEL=gemini-3.5-flash-lite
DEFAULT_BRIDGE_MODEL=gemini-3.5-flash-lite
DEFAULT_GEMINI_MODEL=gemini-3.5-flash-lite
DEFAULT_GROQ_MODEL=llama-3.3-70b-versatile
DEFAULT_OPENROUTER_MODEL=google/gemini-2.5-flash
# RESERVED (deferred to save tokens; not currently used in production pipeline):
DEFAULT_JUDGE_MODEL=gemini-3.5-flash-lite

# --- Narration & Audio Settings ---
DEFAULT_WORDS_PER_MINUTE=140

# --- Database & Storage Configuration ---
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=ALMA
USE_MONGODB=true
REQUIRE_MONGODB=false

# --- Security, Auth & CORS ---
# Comma-separated allowed frontend origins for CORS (no wildcard when credentials allowed)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000
# Comma-separated API keys for X-API-Key header auth
ALMA_API_KEYS=alma_dev_key_12345
# Set to false in production to enforce X-API-Key authentication
ALMA_AUTH_DISABLED=true

# --- Guardrails & Rate Limits ---
MAX_UPLOAD_MB=10
RATE_LIMIT_PER_HOUR=10
MAX_ACTIVE_GENERATIONS=5

# --- Runtime Seed & Job Queue ---
ALMA_SEED_DEMO_DATA=false
JOB_BACKEND=inprocess
REDIS_URL=redis://127.0.0.1:6379/0
